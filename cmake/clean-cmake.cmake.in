set(TALUS_CLEAN_BINARY_DIR "@CMAKE_CURRENT_BINARY_DIR@")
set(TALUS_CLEAN_SOURCE_DIR "@CMAKE_CURRENT_SOURCE_DIR@")

file(REAL_PATH "${TALUS_CLEAN_BINARY_DIR}" TALUS_CLEAN_BINARY_REAL)
file(REAL_PATH "${TALUS_CLEAN_SOURCE_DIR}" TALUS_CLEAN_SOURCE_REAL)

if(TALUS_CLEAN_BINARY_REAL STREQUAL TALUS_CLEAN_SOURCE_REAL)
    message(FATAL_ERROR "Refusing to clean an in-source CMake build tree.")
endif()

if(NOT IS_DIRECTORY "${TALUS_CLEAN_BINARY_REAL}")
    message(FATAL_ERROR "CMake binary directory does not exist: ${TALUS_CLEAN_BINARY_REAL}")
endif()

file(GLOB TALUS_CLEAN_ENTRIES
    LIST_DIRECTORIES true
    "${TALUS_CLEAN_BINARY_REAL}/*"
    "${TALUS_CLEAN_BINARY_REAL}/.[!.]*"
    "${TALUS_CLEAN_BINARY_REAL}/..?*"
)

foreach(TALUS_CLEAN_ENTRY IN LISTS TALUS_CLEAN_ENTRIES)
    get_filename_component(TALUS_CLEAN_NAME "${TALUS_CLEAN_ENTRY}" NAME)
    if(TALUS_CLEAN_NAME STREQUAL "." OR TALUS_CLEAN_NAME STREQUAL "..")
        continue()
    endif()

    file(REMOVE_RECURSE "${TALUS_CLEAN_ENTRY}")
endforeach()

message(STATUS "Removed generated CMake files from ${TALUS_CLEAN_BINARY_REAL}")
